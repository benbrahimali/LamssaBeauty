# Copier en .env puis ajuster. Ne jamais committer le .env réel.
ENV=dev

MONGO_URI=mongodb://localhost:27017
MONGO_DB=lamssa
REDIS_URI=redis://localhost:6379/0

# Générer en prod : python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=30

# OTP — OTP_DEV_CODE est ignoré dès que ENV=prod
OTP_TTL_SEC=300
OTP_DEV_CODE=000000

# Réservation
TIMEZONE=Africa/Tunis
SLOT_STEP_MIN=15
PENDING_TIMEOUT_MIN=15
NO_SHOW_GRACE_MIN=20

# Paiement : mock | konnect | flouci
PSP_PROVIDER=mock
PSP_WEBHOOK_SECRET=change-me
PLATFORM_FEE_PCT=2.5
KONNECT_API_KEY=
KONNECT_WALLET_ID=
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# Notifications — push FCM HTTP v1.
# L'API legacy est fermée depuis le 22/07/2024 : il n'y a plus de « server key »,
# on utilise le compte de service (Firebase > Paramètres > Comptes de service).
# Fichier absent => les push sont loggés en console, le reste de l'API tourne.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=secrets/firebase-admin.json

SMS_PROVIDER=console
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Style DNA — analyse du selfie par modèle vision (§2.4, §8.5).
# Sans clé, /style-dna/status renvoie available=false et l'app masque la carte.
# La clé reste ici : embarquée dans l'APK, elle serait extractible.
ANTHROPIC_API_KEY=
STYLE_DNA_MODEL=claude-opus-5
# low | medium | high | xhigh | max — medium garde l'analyse sous ~10 s
STYLE_DNA_EFFORT=medium
STYLE_DNA_MAX_IMAGE_MB=5

# Génération d'images de coupe (illustration + essayage sur selfie).
# Fournisseur distinct : Claude ne génère pas d'images. Clé sur
# https://aistudio.google.com/apikey — sans elle, l'app masque la fonction.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Médias (vide => disque local ./media)
S3_ENDPOINT=
S3_BUCKET=lamssa-media
S3_KEY=
S3_SECRET=
S3_PUBLIC_BASE=

# Cloudinary — photos de salon et reels vidéo (§3.2, §3.8).
# Console > Dashboard : cloud name, API key, API secret.
# Sans ces clés, les médias sont écrits sur ./media et servis par l'API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reels : 90 s maximum, refusé au-delà.
REEL_MAX_SECONDS=90
REEL_MAX_MB=60

# ── Console d'administration ─────────────────────────────────────────
# Numéros autorisés à ouvrir http://localhost:8000/admin, séparés par
# des virgules. Vide = la console n'ouvre à personne.
ADMIN_PHONES=
